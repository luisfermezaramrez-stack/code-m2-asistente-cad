  "cards": [
    {
      "dot": "cyan",
      "title": "Errores → HTTP",
      "items": [
        "Pieza declinada o verificación fallida → HTTP 422",
        "Modelo no disponible o error de traducción → HTTP 503",
        "Texto vacío o mayor a 1000 caracteres → rechazo en validación"
      ]
    },
    {
      "dot": "emerald",
      "title": "Verificación honesta",
      "items": [
        "dsl.check aprueba o declina cada programa antes de construir (AC1)",
        "El modelo declina piezas fuera del catálogo en vez de sustituirlas",
        "STEP es B-rep de OpenCascade; volumen y caja dentro de ±2 % (AC3)"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacidad y alcance",
      "items": [
        "El registro excluye correos y nombres declarados (Ley 1581 de 2012)",
        "La interfaz solo entrega archivos dentro de outputs/ (archivo_seguro)",
        "Toda salida es preliminar: exige revisión de un profesional responsable"
      ]
    }
