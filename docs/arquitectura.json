  "cards": [
    {
      "dot": "cyan",
      "title": "Errores → HTTP",
      "items": [
        "Texto vacío o mayor a 1000 caracteres → 422 (Pydantic)",
        "Pieza declinada o verificación fallida → 422 con motivo",
        "Modelo no disponible → 503 con mensaje en español"
      ]
    },
    {
      "dot": "emerald",
      "title": "Verificación honesta",
      "items": [
        "dsl.check aprueba o declina cada programa antes de construir",
        "Fuera del catálogo se declina con motivo, nunca se sustituye",
        "STEP es B-rep de OpenCascade, marcado como diseño preliminar"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacidad y observabilidad",
      "items": [
        "Registro y MLflow eliminan correos y nombres (Ley 1581 de 2012)",
        "El seguimiento es best-effort: si MLflow cae, la pieza se entrega igual",
        "La UI de MLflow y la app solo escuchan en 127.0.0.1"
      ]
    }
  ]
