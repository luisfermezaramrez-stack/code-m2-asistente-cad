{
  "components": {
    "schemas": {
      "EstadoTrabajo": {
        "description": "JSON de consulta, cancelación y data SSE; opcional significa campo ausente.",
        "properties": {
          "cancelacion_remota_confirmada": {
            "title": "Cancelacion Remota Confirmada",
            "type": "boolean"
          },
          "cancelacion_solicitada": {
            "title": "Cancelacion Solicitada",
            "type": "boolean"
          },
          "codigo_http": {
            "title": "Codigo Http",
            "type": "integer"
          },
          "estado": {
            "enum": [
              "iniciando",
              "validando",
              "generando",
              "verificado",
              "declinado",
              "error",
              "cancelado"
            ],
            "title": "Estado",
            "type": "string"
          },
          "motivo": {
            "title": "Motivo",
            "type": "string"
          },
          "pipeline_detenido": {
            "title": "Pipeline Detenido",
            "type": "boolean"
          },
          "resultado": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Resultado",
            "type": "object"
          },
          "secuencia": {
            "title": "Secuencia",
            "type": "integer"
          },
          "solicitud_id": {
            "title": "Solicitud Id",
            "type": "string"
          },
          "terminal": {
            "title": "Terminal",
            "type": "boolean"
          }
        },
        "required": [
          "solicitud_id",
          "estado",
          "terminal",
          "cancelacion_solicitada"
        ],
        "title": "EstadoTrabajo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SolicitudGenerar": {
        "description": "Define y valida la entrada del servicio CAD.",
        "properties": {
          "texto": {
            "description": "Descripción técnica de la pieza en español.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Texto",
            "type": "string"
          }
        },
        "required": [
          "texto"
        ],
        "title": "SolicitudGenerar",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Servicio de generación preliminar de componentes CAD.",
    "title": "M2 CAD Assistant API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/generaciones/{solicitud_id}": {
      "delete": {
        "description": "202 pide detenerse; solo un estado terminal confirma el desenlace real.",
        "operationId": "cancelar_generacion_v1_generaciones__solicitud_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Cancelación solicitada, no confirmada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancelar Generacion"
      },
      "get": {
        "description": "Consulta la confirmación terminal incluso después de perder la conexión SSE.",
        "operationId": "consultar_generacion_v1_generaciones__solicitud_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar Generacion"
      }
    },
    "/v1/generaciones/{solicitud_id}/archivos/{formato}": {
      "get": {
        "description": "Entrega solo artefactos existentes del resultado verificado de este trabajo.",
        "operationId": "descargar_archivo_v1_generaciones__solicitud_id__archivos__formato__get",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "formato",
            "required": true,
            "schema": {
              "title": "Formato",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Descargar Archivo"
      }
    },
    "/v1/generar": {
      "post": {
        "description": "Procesa una solicitud CAD validada, la registra (AC3/AC4) y la mide (HU-16).",
        "operationId": "generar_v1_generar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudGenerar"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Generar V1 Generar Post",
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-data-schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generar"
      }
    },
    "/v1/health": {
      "get": {
        "description": "Comprueba que el proceso de la API está disponible.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/ready": {
      "get": {
        "description": "Disponibilidad operativa local; /health conserva el contrato de vida.",
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/registros/{identificador}": {
      "get": {
        "description": "Consulta una fila existente, sin escribir ni duplicar el registro (HU-07 AC3).",
        "operationId": "consultar_registro_v1_registros__identificador__get",
        "parameters": [
          {
            "in": "path",
            "name": "identificador",
            "required": true,
            "schema": {
              "title": "Identificador",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Consultar Registro V1 Registros  Identificador  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar Registro"
      }
    },
    "/v1/registros/{identificador}/step": {
      "get": {
        "description": "Enlaza el STEP del registro persistente, incluso tras reiniciar los trabajos.",
        "operationId": "descargar_step_v1_registros__identificador__step_get",
        "parameters": [
          {
            "in": "path",
            "name": "identificador",
            "required": true,
            "schema": {
              "title": "Identificador",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Descargar Step"
      }
    }
  }
}
