{
  "components": {
    "schemas": {
      "Credenciales": {
        "description": "Credenciales HU-53; la clave nunca se registra ni se devuelve.",
        "properties": {
          "clave": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Clave",
            "type": "string"
          },
          "usuario": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Usuario",
            "type": "string"
          }
        },
        "required": [
          "usuario",
          "clave"
        ],
        "title": "Credenciales",
        "type": "object"
      },
      "EstadoTrabajo": {
        "description": "JSON de consulta, cancelación y data SSE; opcional significa campo ausente.",
        "properties": {
          "cancelacion_remota_confirmada": {
            "title": "Cancelacion Remota Confirmada",
            "type": "boolean"
          },
          "cancelacion_solicitada": {
            "title": "Cancelacion Solicitada",
            "type": "boolean"
          },
          "codigo_http": {
            "title": "Codigo Http",
            "type": "integer"
          },
          "estado": {
            "enum": [
              "iniciando",
              "validando",
              "generando",
              "verificado",
              "declinado",
              "error",
              "cancelado"
            ],
            "title": "Estado",
            "type": "string"
          },
          "motivo": {
            "title": "Motivo",
            "type": "string"
          },
          "pipeline_detenido": {
            "title": "Pipeline Detenido",
            "type": "boolean"
          },
          "resultado": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Resultado",
            "type": "object"
          },
          "secuencia": {
            "title": "Secuencia",
            "type": "integer"
          },
          "solicitud_id": {
            "title": "Solicitud Id",
            "type": "string"
          },
          "terminal": {
            "title": "Terminal",
            "type": "boolean"
          }
        },
        "required": [
          "solicitud_id",
          "estado",
          "terminal",
          "cancelacion_solicitada"
        ],
        "title": "EstadoTrabajo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RespuestaUso": {
        "description": "Gasto acumulado del día y topes vigentes (HU-32, RF-5).",
        "properties": {
          "costo_usd": {
            "title": "Costo Usd",
            "type": "number"
          },
          "fecha": {
            "format": "date",
            "title": "Fecha",
            "type": "string"
          },
          "generaciones": {
            "title": "Generaciones",
            "type": "integer"
          },
          "limite_solicitudes_ventana": {
            "title": "Limite Solicitudes Ventana",
            "type": "integer"
          },
          "moneda": {
            "title": "Moneda",
            "type": "string"
          },
          "presupuesto_diario_usd": {
            "title": "Presupuesto Diario Usd",
            "type": "number"
          },
          "ventana_segundos": {
            "title": "Ventana Segundos",
            "type": "integer"
          }
        },
        "required": [
          "fecha",
          "costo_usd",
          "moneda",
          "generaciones",
          "presupuesto_diario_usd",
          "limite_solicitudes_ventana",
          "ventana_segundos"
        ],
        "title": "RespuestaUso",
        "type": "object"
      },
      "SolicitudGenerar": {
        "description": "Define y valida la entrada del servicio CAD.",
        "properties": {
          "texto": {
            "description": "Descripción técnica de la pieza en español.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Texto",
            "type": "string"
          }
        },
        "required": [
          "texto"
        ],
        "title": "SolicitudGenerar",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Servicio de generación preliminar de componentes CAD.",
    "title": "M2 CAD Assistant API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/auth/login": {
      "post": {
        "description": "AC1: emite una cookie firmada sólo para credenciales válidas.\n\nLos intentos se anotan y limitan (429 con ``Retry-After``) antes de derivar la\nclave, para frenar la fuerza bruta sin gastar CPU en PBKDF2.",
        "operationId": "iniciar_sesion_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credenciales"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "title": "Response Iniciar Sesion V1 Auth Login Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Iniciar Sesion"
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Elimina la cookie de sesión; el cliente debe volver a autenticarse.",
        "operationId": "cerrar_sesion_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Cerrar Sesion V1 Auth Logout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cerrar Sesion"
      }
    },
    "/v1/auth/me": {
      "get": {
        "description": "Expone a la SPA si la sesión es necesaria y cuál es el usuario activo.",
        "operationId": "estado_sesion_actual_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": "Response Estado Sesion Actual V1 Auth Me Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Estado Sesion Actual"
      }
    },
    "/v1/generaciones/{solicitud_id}": {
      "delete": {
        "description": "202 pide detenerse; solo un estado terminal confirma el desenlace real.",
        "operationId": "cancelar_generacion_v1_generaciones__solicitud_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Cancelación solicitada, no confirmada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancelar Generacion"
      },
      "get": {
        "description": "Consulta la confirmación terminal incluso después de perder la conexión SSE.",
        "operationId": "consultar_generacion_v1_generaciones__solicitud_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar Generacion"
      }
    },
    "/v1/generaciones/{solicitud_id}/archivos/{formato}": {
      "get": {
        "description": "Entrega solo artefactos propios y verificados; el token de HU-36 sigue vigente.",
        "operationId": "descargar_archivo_v1_generaciones__solicitud_id__archivos__formato__get",
        "parameters": [
          {
            "in": "path",
            "name": "solicitud_id",
            "required": true,
            "schema": {
              "title": "Solicitud Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "formato",
            "required": true,
            "schema": {
              "title": "Formato",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Descargar Archivo"
      }
    },
    "/v1/generar": {
      "post": {
        "description": "Procesa una solicitud CAD validada, la registra (AC3/AC4) y la mide (HU-16).",
        "operationId": "generar_v1_generar_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudGenerar"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Generar V1 Generar Post",
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-data-schema": {
                  "$ref": "#/components/schemas/EstadoTrabajo"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "La clave de idempotencia ya se usó con otra solicitud."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Límite por ventana excedido o presupuesto diario agotado."
          }
        },
        "summary": "Generar"
      }
    },
    "/v1/health": {
      "get": {
        "description": "Comprueba que el proceso de la API está disponible (AC4: sin credenciales).",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/ready": {
      "get": {
        "description": "Disponibilidad operativa local; /health conserva el contrato de vida.",
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/registros/{identificador}": {
      "get": {
        "description": "Consulta una fila propia, sin revelar la de otros usuarios (HU-53, AC2).",
        "operationId": "consultar_registro_v1_registros__identificador__get",
        "parameters": [
          {
            "in": "path",
            "name": "identificador",
            "required": true,
            "schema": {
              "title": "Identificador",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Consultar Registro V1 Registros  Identificador  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar Registro"
      }
    },
    "/v1/registros/{identificador}/step": {
      "get": {
        "description": "Enlaza el STEP propio del registro persistente, incluso tras reiniciar.",
        "operationId": "descargar_step_v1_registros__identificador__step_get",
        "parameters": [
          {
            "in": "path",
            "name": "identificador",
            "required": true,
            "schema": {
              "title": "Identificador",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Descargar Step"
      }
    },
    "/v1/uso": {
      "get": {
        "description": "RF-5/AC4: gasto acumulado del día, sin red ni identificadores de cliente.",
        "operationId": "consultar_uso_v1_uso_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaUso"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Consultar Uso"
      }
    }
  }
}
