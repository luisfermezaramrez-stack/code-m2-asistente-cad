# Copia este archivo como `.env` y completa los valores. `.env` nunca se
# versiona (está en .gitignore); este ejemplo sí, para documentar la
# configuración esperada por src/m2_cad.

# HU-14: español directo a DeepSeek; sin traducción ni GPU.
# Consíguela en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

LLM_MODEL=deepseek-v4-pro
# Opcional: endpoint compatible con OpenAI; este es el valor por defecto.
LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=  # Alias opcional para otros proveedores; solo en el backend.

# HU-25: reintentos y caché del LLM. El plazo total (120 s) no se configura aquí.
# LLM_MAX_RETRIES=2                 # 0–5; sólo 500/502/503/504, timeout y conexión.
# LLM_RETRY_BASE_SECONDS=0.25       # Base del backoff exponencial con jitter.
# LLM_RETRY_MAX_SECONDS=3           # Tope de espera de cada reintento.
# LLM_CACHE_TTL_SECONDS=1800        # 0 desactiva la caché de respuestas.
# LLM_CACHE_MAX_ITEMS=256           # 0 desactiva la caché de respuestas.

# HU-15: Vue y FastAPI en un origen; sin URLs del modelo en el frontend.
M2_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# M2_FRONTEND_DIST=frontend/dist  # Docker fija /app/frontend/dist.

# HU-45: cola persistente de SSE y worker separado. En despliegue se comparte
# el mismo archivo entre la API y el worker (en Docker: /app/data/cola.json).
# M2_COLA_HABILITADA=0 deja la ejecución SSE en el proceso de la API (solo pruebas heredadas).
M2_COLA_HABILITADA=1
M2_COLA_PATH=data/cola.json

# HU-36: secreto de firma persistente, propio del entorno; NUNCA lo subas a Git.
# Generarlo: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Guardarlo en un .env local ignorado o en un gestor de secretos.
M2_DOWNLOAD_SECRET=
# Caducidad del token en segundos (por defecto una hora).
M2_DOWNLOAD_TTL_SECONDS=3600

# HU-53: autenticación activa por defecto. Sólo development local la desactiva.
# M2_AUTH_ENABLED=0
# Secreto HMAC de la cookie (>=32 bytes); NUNCA lo subas a Git.
# Generarlo: python3 -c 'import secrets; print(secrets.token_hex(32))'
M2_AUTH_SECRET=
# JSON usuario -> hash PBKDF2. Generar cada hash con `make hash-clave`.
# Ejemplo (NO versionar claves reales): M2_AUTH_USERS={"ana":"pbkdf2_sha256$..."}
M2_AUTH_USERS=
# Cookie HttpOnly/SameSite=Lax; Secure se exige salvo en HTTP local.
# M2_AUTH_COOKIE_SECURE=0
# M2_AUTH_TTL_SECONDS=86400        # 60–2592000 segundos.

# HU-24: nivel del logging estructurado (DEBUG/INFO/WARNING/ERROR/CRITICAL).
# Cada línea de m2_cad se emite en JSON con request_id y, en SSE, job_id.
M2_LOG_LEVEL=INFO

# HU-32: control de uso. Cero desactiva cada control (comportamiento por defecto).
# M2_LIMITE_SOLICITUDES_VENTANA=0   # Solicitudes por sesión y ventana.
# M2_VENTANA_SEGUNDOS=60            # Duración de la ventana en segundos.
# M2_PRESUPUESTO_DIARIO_USD=0       # Presupuesto UTC en USD; GET /uso lo acumula.
# MLFLOW_PRECIO_ENTRADA=0           # USD por millón de tokens de entrada.
# MLFLOW_PRECIO_SALIDA=0            # USD por millón de tokens de salida.
