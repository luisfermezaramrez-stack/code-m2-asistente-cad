# Copia este archivo como `.env` y completa los valores. `.env` nunca se
# versiona (está en .gitignore); este ejemplo sí, para documentar la
# configuración esperada por src/m2_cad.

# HU-14: español directo a DeepSeek; sin traducción ni GPU.
# Consíguela en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

LLM_MODEL=deepseek-v4-pro
# Opcional: endpoint compatible con OpenAI; este es el valor por defecto.
LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=  # Alias opcional para otros proveedores; solo en el backend.

# HU-15: Vue y FastAPI en un origen; sin URLs del modelo en el frontend.
M2_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# M2_FRONTEND_DIST=frontend/dist  # Docker fija /app/frontend/dist.
