# Copia este archivo como `.env` y completa los valores. `.env` nunca se
# versiona (está en .gitignore); este ejemplo sí, para documentar la
# configuración esperada por src/m2_cad.

# Clave de la API Gemini para la traducción ES→EN (traduccion.py).
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL del servidor llama.cpp que sirve el modelo GGUF (pipeline.py).
# `docker compose` la fija automáticamente entre servicios: http://llama:8080
LLM_BASE_URL=http://127.0.0.1:8080

# URL de la API FastAPI que consume la interfaz Gradio (interfaz.py).
# `docker compose` la fija automáticamente entre servicios: http://m2-cad:8000
M2_API_URL=http://127.0.0.1:8000

# Host y puerto donde escucha la interfaz Gradio (interfaz.py).
M2_UI_HOST=0.0.0.0
M2_UI_PORT=7860

# Tiempo de espera en segundos de la interfaz hacia la API (interfaz.py).
M2_API_TIMEOUT=70
